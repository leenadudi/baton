# Backend secrets — FastAPI host only (local .env here, Render env vars in prod).
# Copy to backend/.env and fill in real values. Never commit .env.
# These must NEVER be prefixed with VITE_ or exposed to the frontend bundle.

# OpenAI API key for the /extract note-extraction pipeline (Nicole's slice)
OPENAI_API_KEY=

# Base URL of the FHIR server Amy loads Synthea data into (e.g. public HAPI FHIR)
FHIR_BASE_URL=

# Comma-separated extra CORS origins for the API (localhost:5173 is always allowed)
CORS_ORIGINS=

# Optional: MongoDB Atlas connection string. When set, users, tokens, shared
# unit state, and the audit trail persist in the `baton` database. When unset,
# everything runs in memory (fine for local dev and the demo).
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

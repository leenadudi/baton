# Backend secrets — FastAPI host only (local .env here, Render env vars in prod).
# Copy to backend/.env and fill in real values. Never commit .env.
# These must NEVER be prefixed with VITE_ or exposed to the frontend bundle.

# OpenAI API key for the /extract note-extraction pipeline (Nicole's slice)
OPENAI_API_KEY=

# Base URL of the FHIR server Amy loads Synthea data into (e.g. public HAPI FHIR)
FHIR_BASE_URL=

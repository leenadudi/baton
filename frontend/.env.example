# Frontend env — Vite inlines VITE_* vars into the PUBLIC JS bundle.
# Copy to frontend/.env for local dev; set the same var in Vercel for prod.
# VITE_API_URL is the ONLY frontend env var allowed. No secrets here, ever.

# Public URL of the FastAPI backend (http://localhost:8000 in dev, Render URL in prod)
VITE_API_URL=http://localhost:8000

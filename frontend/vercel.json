{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/proxy/:path*", "destination": "https://baton-mf85.onrender.com/:path*" },
    { "source": "/((?!assets/|prototype.html|proxy/).*)", "destination": "/index.html" }
  ]
}
